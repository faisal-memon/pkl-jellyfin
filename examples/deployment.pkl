amends "../src/render/DockerCompose.pkl"

import "../src/Jellyfin.pkl"

config {
  jellyfin = new Jellyfin {
    image = "jellyfin/jellyfin:10.11.11"
    media = new {
      new Jellyfin.MediaMount { hostPath = "/srv/media"; containerPath = "/media" }
    }
  }
  hostConfigDirectory = "./data/config"
  hostCacheDirectory = "./data/cache"
}
