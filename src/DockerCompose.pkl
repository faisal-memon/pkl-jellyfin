/// A typed Jellyfin server rendered as Docker Compose YAML.
module jellyfin.Jellyfin
import "@docker/src/Compose.pkl"
config: Config = new Config {}
class Config {
  jellyfin: JellyfinConfig = new JellyfinConfig {}
  docker: DockerConfig = new DockerConfig {}
}
class JellyfinConfig {
  imageRepository: String(!isEmpty) = "jellyfin/jellyfin"
  imageVersion: String(!isEmpty) = "10.11.11"
  containerName: String(!isEmpty) = "jellyfin"
  restart: String(!isEmpty) = "unless-stopped"
}
class DockerConfig {
  hostConfigDirectory: String(!isEmpty) = "./data/config"
  hostCacheDirectory: String(!isEmpty) = "./data/cache"
  ports: Listing<PortConfig> = new { new PortConfig { published = 8096; target = 8096 }; new PortConfig { published = 7359; target = 7359; protocol = "udp" } }
  volumeMounts: Listing<VolumeMount> = new {}
  networks: Mapping<String, NetworkConfig> = new {}
  hardwareAcceleration: HardwareAcceleration? = null
}
class PortConfig {
  hostIp: String? = null
  published: Int(isBetween(1, 65535))
  target: Int(isBetween(1, 65535))
  protocol: String(matches(Regex("tcp|udp"))) = "tcp"
}
class VolumeMount { hostPath: String(!isEmpty); containerPath: String(!isEmpty); readOnly: Boolean = true }
class NetworkConfig { `external`: Boolean = false }
class HardwareAcceleration { device: String(!isEmpty); renderGroup: String? = null }
services = new Mapping {
  [config.jellyfin.containerName] = new Compose.Service {
    image = "\(config.jellyfin.imageRepository):\(config.jellyfin.imageVersion)"
    restart = config.jellyfin.restart
    ports = new Listing { for (port in config.docker.ports) { new Compose.Port { host_ip = port.hostIp; published = port.published; target = port.target } } }
    volumes = new Listing {
      new Compose.Volume { source = config.docker.hostConfigDirectory; target = "/config" }
      new Compose.Volume { source = config.docker.hostCacheDirectory; target = "/cache" }
      for (mount in config.docker.volumeMounts) { new Compose.Volume { source = mount.hostPath; target = mount.containerPath; `read_only` = mount.readOnly } }
    }
    networks = new Listing { for (network in config.docker.networks.keys) { network } }
    when (config.docker.hardwareAcceleration != null) { devices = new Listing { config.docker.hardwareAcceleration.device } }
  }
}
networks = new Mapping { for (name, network in config.docker.networks) { [name] = new Compose.Network { `external` = network.`external` } } }
output { value = new Dynamic { services = module.services; networks = module.networks }; renderer = new YamlRenderer {} }
